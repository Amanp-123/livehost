# ==========================================
# Vercel & Production Deployment .gitignore
# ==========================================

# Dependencies (Never deploy to Vercel/Git)
node_modules/
*/node_modules/
client/node_modules/
server/node_modules/
.pnpm-store/

# Local Environment Variables & Secrets (CRITICAL: Never commit credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
client/.env
server/.env
*.pem
*.key

# Local Build & Dist Outputs (Vercel builds on cloud directly)
dist/
dist-ssr/
build/
client/dist/
out/
.next/

# Vercel Project Metadata (Generated locally by Vercel CLI)
.vercel/

# Logs & Debugging Artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cache & Temporary Files
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo
.temp/
tmp/
scratch/

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
